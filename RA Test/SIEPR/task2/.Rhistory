# Load Dependencies
suppressWarnings(source('S:/Monroe/Mary/Cheatsheet/R/Functions/Mary_setup.R'))
haver_start <- "2007-01-01" %>% as.Date()
haver_end <- Sys.Date()
## Q4/Q4 Calculation
Qq4q4 <- function(x){
((x/lag(x, 4) - 1))*100
}
# Real GDP Growth Rate
RGDP <-
haver.data(codes = 'USECON:GDP',
start = haver_start,
end = haver_end,
freq = 'q',
rtype = 'data.frame', eop.dates = TRUE) %>%
rownames_to_column(var = "date") %>%
as_tibble %>%
dplyr::rename(rate = gdp) %>%
#na.omit %>%
mutate(date = as.Date(.$date)) %>%
mutate(date = as.Date(paste0(year(date),"-",month(date),'-01')))  %>%
mutate(rate = Qq4q4(rate))
# Real GDP Growth Long Run Projection
GDP_LR <-
haver.data('Surveys:gdlm',
rtype = 'data.frame') %>%
rownames_to_column(var = "date") %>%
as_tibble %>%
na.omit %>%
mutate(date = as.Date(paste0(date, "-01"), format = "%Y-%b-%d")) %>%
dplyr::rename('LR GDP' = gdlm) %>%
na.omit()
# GDP archive *Metadata
meta <-
haver.metadata(database = 'surveys') %>%
as_tibble() %>%
filter(grepl('^gdpm...', .$code)) %>%
filter(grepl('...Central...', .$descriptor)) %>%
select(code, startdate, enddate, numobs, datetimemod, descriptor) %>%
mutate(Meeting_Date = gsub(".*(\\w{3})\\-(\\d{2})(\\))", "\\1 20\\2", .$descriptor)) %>%
mutate(Date = as.Date(as.yearmon(.$Meeting_Date))) %>%
na.omit()
# Format Codes
codes <- lapply(meta$code, function(x){paste0("Surveys:",x)}) %>% unlist()
# Path Data
path_data <-
haver.data(
codes = codes,
rtype = "data.frame") %>%
rownames_to_column(var = "date") %>%
as_tibble()
codes <- meta %>% select(code, Date) %>% dplyr::rename(date = Date)
long_data <-
path_data %>%
dplyr::rename(forecast_y = date) %>%
gather(code , rate, -c(forecast_y)) %>%
na.omit
codes_date <-
full_join(long_data, codes, by = 'code') %>%
mutate(forecast_y = as.Date(paste0(forecast_y,'-',month(date),'-01'))) %>%
right_join(RGDP, by = c("date"))
# Find GDP Forecast beginning to lag 1
GDP_start <- codes_date$date[max((which(is.na(codes_date$forecast_y) & !is.na(codes_date$rate.y))))]
codes_date %>% filter(date >= GDP_start)
GDP_trimmed <- RGDP %>% filter(date >= GDP_start)
meta2 <- meta[,c("code","Date")] %>%
right_join(GDP_trimmed, by= c('Date' = 'date')) %>%
mutate(lag_date = lag(Date), lag_rate = lag(rate)) %>%
dplyr::rename(date = Date,  rate.x = lag_rate, forecast_y = lag_date, rate.y = rate) %>%
select(forecast_y, code, rate.x, date, rate.y) %>%
rbind(codes_date) %>%
filter(date >= GDP_start)
# Federal Funds Long-Run Chart
GDPLR <-
ggplot(meta2, aes(x = date)) +
get_recessions(min(meta2$date), max(meta2$date)) +
geom_line(aes(x = forecast_y, y = rate.x, color = code), size = 1) +
geom_hline(yintercept = 2, size = 1, linetype = "dashed") +
geom_point(aes(x = forecast_y, y = rate.x, color = code)) +
geom_point(aes(y = rate.y), size = 2) +
geom_line(aes(y = rate.y), size = 1.5) +
theme_mary() +
scale_x_date(
limits = c(as.Date(min(meta2$date)), tail(meta2$forecast_y, 1)+70),
date_breaks = "6 months",
date_labels = "%b \'%y",
expand = c(0, 0)
) +
theme(axis.text = element_text(size = 8),
legend.position = 'none') +
labs(
title = 'SEP Historical Projections for Real GDP',
caption = 'Source: Federal Reserve Board',
subtitle = 'Percent',
yaxis = ''
)
GDPLR
View(meta2)
